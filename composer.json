{
  "name": "ashita-planning/laravel-error-monitor-xserver",
  "description": "XServer stored log adapter for ashita-planning/laravel-error-monitor.",
  "keywords": ["laravel", "xserver", "error-monitoring", "logs"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "ashita-planning/laravel-error-monitor": "^1.2",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Apkk\\LaravelErrorMonitorXserver\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apkk\\LaravelErrorMonitorXserver\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Apkk\\LaravelErrorMonitorXserver\\XserverLogSourceServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "format": "pint",
    "format:test": "pint --test",
    "check": ["@format:test", "@analyse", "@test"]
  },
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true
}
